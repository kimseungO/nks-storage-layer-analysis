#!/usr/bin/env bash
# =============================================================================
# observe.sh — 계층별 동시 관측 도우미
#
# 목적:
#   fio 실행 중 하위 계층을 동시에 관측하여, 클라이언트가 보고한 수치와
#   실제 물리 I/O를 교차 확인합니다.
#
# 사용법:
#   # 호스트에서 — OSD 물리 파티션 관측 (장치명 자동 탐지)
#   ./observe.sh iostat-osd L2
#
#   # 호스트에서 — 벤치마크 전용 파티션 관측
#   ./observe.sh iostat-bench L0
#
#   # controller에서 — Ceph 관측 명령어 출력
#   ./observe.sh ceph
#
# 주의:
#   NVMe 장치명(nvme0n1 / nvme1n1)은 재부팅 시 뒤바뀔 수 있으므로,
#   이 스크립트는 /dev/disk/by-id 경로로 실제 장치명을 조회합니다.
# =============================================================================

set -euo pipefail

ACTION="${1:-}"
LAYER="${2:-manual}"

# 환경에 맞게 수정하십시오
DISK_ID_PATTERN="${DISK_ID_PATTERN:-nvme-WD_BLACK*}"
OSD_PARTS=(3 4 5)     # OSD가 위치한 파티션 번호
BENCH_PART=6          # L0/L1 벤치마크 전용 파티션 번호

resolve_part() {
    # 파티션 번호를 받아 현재 커널 장치명으로 변환
    local n="$1"
    local path
    path=$(ls -1 /dev/disk/by-id/${DISK_ID_PATTERN}-part${n} 2>/dev/null | head -1)
    if [[ -z "$path" ]]; then
        echo "[오류] 파티션을 찾을 수 없습니다: part${n}" >&2
        echo "       DISK_ID_PATTERN 환경변수를 확인하십시오." >&2
        exit 1
    fi
    basename "$(readlink -f "$path")"
}

usage() {
    cat <<'EOF'
사용법:
  ./observe.sh iostat-osd   <layer>   # OSD 물리 파티션 3개 관측 (L2 이상)
  ./observe.sh iostat-bench <layer>   # 벤치마크 전용 파티션 관측 (L0/L1)
  ./observe.sh ceph                   # Ceph 관측 명령어 안내
  ./observe.sh devices                # 현재 장치명 조회만 수행

환경변수:
  DISK_ID_PATTERN  /dev/disk/by-id 패턴 (기본: nvme-WD_BLACK*)
EOF
    exit 1
}

case "$ACTION" in
devices)
    echo "현재 장치명 매핑"
    echo "-------------------------"
    for n in "${OSD_PARTS[@]}" "$BENCH_PART"; do
        printf "part%-2s → %s\n" "$n" "$(resolve_part "$n")"
    done
    ;;

iostat-osd)
    OUT="./results/$LAYER/iostat_$LAYER.log"
    mkdir -p "$(dirname "$OUT")"
    DEVS=()
    for n in "${OSD_PARTS[@]}"; do DEVS+=("$(resolve_part "$n")"); done
    echo "관측 대상: ${DEVS[*]}"
    echo "로그 저장: $OUT"
    echo "종료하려면 Ctrl+C"
    echo ""
    iostat -x 1 "${DEVS[@]}" | tee "$OUT"
    ;;

iostat-bench)
    OUT="./results/$LAYER/iostat_$LAYER.log"
    mkdir -p "$(dirname "$OUT")"
    DEV="$(resolve_part "$BENCH_PART")"
    echo "관측 대상: $DEV"
    echo "로그 저장: $OUT"
    echo "종료하려면 Ctrl+C"
    echo ""
    iostat -x 1 "$DEV" | tee "$OUT"
    ;;

ceph)
    cat <<'EOF'
controller 노드에서 별도 터미널로 실행하십시오.

[터미널 A] OSD별 지연 관측
  watch -n 1 'ceph osd perf'

  - apply_latency  : 쓰기를 디스크에 적용한 시간
  - commit_latency : 저널 커밋까지의 시간
  - 읽기 부하에서는 유의미한 변화가 나타나지 않습니다.

[터미널 B] 클러스터 상태 및 client io
  watch -n 1 'ceph -s'

  - pgs가 active+clean을 유지하는지 확인합니다.
  - degraded 상태에서 측정한 데이터는 신뢰할 수 없습니다.
  - client io 항목으로 Ceph 관점의 처리량을 확인할 수 있습니다.
EOF
    ;;

*)
    usage
    ;;
esac
